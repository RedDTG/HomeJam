{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "allowJs": false,
    "isolatedModules": false,
    "incremental": false,
    "plugins": []
  },
  "include": ["src/server.ts"]
}
